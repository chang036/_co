/**
 * And gate: 
 * out = 1 if (a == 1 and b == 1)
 *       0 otherwise
 */

CHIP And {
    IN a, b;
    OUT out;

    PARTS:
    // Put your code here:
    // 1. Get the NAND result of a and b
    Nand(a=a, b=b, out=nandOut);

    // 2. Invert the result using NAND as a NOT gate
    Nand(a=nandOut, b=nandOut, out=out);
}
